# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the grading model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Feature switches (off unless set to "true"; rebuild/redeploy after changing)
# NEXT_PUBLIC_FEATURE_MOCK_EXAM=true
# NEXT_PUBLIC_FEATURE_AI_GENERATION=true

# Daily AI limits per user (defaults: 15 scores, 3 generated tests, 10 generated prompts)
# SCORING_DAILY_LIMIT=15
# GENERATE_TEST_DAILY_LIMIT=3
# GENERATE_PROMPT_DAILY_LIMIT=10

# Comma-separated emails that can open /admin/usage
# ADMIN_EMAILS=you@example.com
